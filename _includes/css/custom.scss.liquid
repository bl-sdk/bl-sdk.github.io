@import "./custom/custom";

// By default callouts use a transparent background, replace it with a solid one to prevent any
// background patterns from peeking through
{%- for callout in site.callouts %}
p.{{ callout[0] }}, blockquote.{{ callout[0] }} {
    background: mix(${{ callout[1].color }}-{{ callout_background_hue }}, $body-background-color, 15%);
}
{%- endfor -%}

// TODO: move to standard scss file once we turn this on unconditionally
{%- if site.unreviewed_mods.fade -%}
// Grey out unreviewed mods a little
.nav-list .nav-list-item.unreviewed .nav-list-link {
    & {
        color: darken($link-color, 15%);
    }
    &:hover, &.active {
        // Normal hover is 5% darker already
        color: darken($link-color, 20%);
    }
}
{%- endif -%}
